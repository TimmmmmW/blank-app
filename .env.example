# Voorbeeld configuratie voor web scraper
# Kopieer dit bestand naar .env en vul je eigen waarden in

# Website configuratie
BASE_URL=https://example.com
LOGIN_URL=/login

# Login credentials (Formulier login)
USERNAME=jouw_gebruikersnaam
PASSWORD=jouw_wachtwoord

# Formulier velden (voor basis scraper)
USERNAME_FIELD=username
PASSWORD_FIELD=password

# CSS Selectors (voor geavanceerde scraper)
USERNAME_SELECTOR=#username
PASSWORD_SELECTOR=#password
SUBMIT_SELECTOR=button[type='submit']

# API Token (indien van toepassing)
API_TOKEN=your-api-token-here
TOKEN_TYPE=Bearer

# Scraper instellingen
HEADLESS=true
BROWSER_TYPE=chromium
WAIT_TIME=1.0

# Data extractie selectors
TITLE_SELECTOR=h1.title
CONTENT_SELECTOR=.article-content
LINK_SELECTOR=a.article-link
